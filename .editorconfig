# Spec 0008 FMT-4: basics for every file. server/.editorconfig adds the C# rules on top.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{*.cs,Dockerfile,*.sh,Caddyfile}]
indent_size = 4
